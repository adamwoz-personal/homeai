# Template rendered by install.sh: @REPO@ is substituted.
# The Jarvis avatar window (plans/AVATAR_PLAN.md). Starts with the desktop
# session, independent of the voice daemon: without it the window shows
# "offline" and reconnects when the daemon comes back.
[Unit]
Description=Home AI avatar window
Documentation=file://@REPO@/docs/RUNBOOK.md
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/.env
Environment=PYTHONUNBUFFERED=1
# Phase 0 spike: XWayland restores the window position; the iGPU renders it
# and leaves all of the 7900 XT's VRAM for the models.
Environment=SDL_VIDEODRIVER=x11
Environment=DRI_PRIME=1
ExecStart=@REPO@/.venv/bin/python -m homeai.avatar.app
Restart=on-failure
RestartSec=5
# Sandbox, as measured 2026-11-13 (plans/SANDBOX_PLAN.md): these two are in
# force (/proc/<pid>/status: NoNewPrivs 1, Seccomp 2). There is deliberately no
# filesystem sandbox: ProtectHome/ProtectSystem are silently skipped in user
# units on this box (Ubuntu's AppArmor userns rule), and the window needs the
# display and GPU anyway. It only reads the repo and the event-bus socket.
NoNewPrivileges=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target

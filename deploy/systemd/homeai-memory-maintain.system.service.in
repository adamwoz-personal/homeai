# Template rendered by tools/install_memory_system_units.sh (SANDBOX_PLAN, 2026-11-12):
# @USER@ @HOME@ @REPO@ are substituted.
# Hourly memory health sample, plus whatever maintenance it says is due
# (VACUUM, purge of long-archived facts; the rest is only reported). A system
# unit with User= so the sandbox below is enforced (tools/probe_unit_sandbox.sh).
# `journalctl -u homeai-memory-maintain` shows "healthy, no work" or what ran.
[Unit]
Description=Home AI memory health sample and maintenance
Documentation=file://@REPO@/docs/RUNBOOK.md
After=postgresql.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
Environment=HOME=@HOME@
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/.env
ExecStart=@REPO@/bin/homeai-memory maintain --time-limit 600
TimeoutStartSec=900
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
